(defun cria-tabuleiro ()
  (list 
   (list nil nil nil) 
   (list nil nil nil) 
   (list nil nil nil)
  )
)

(defun imprime-linha (linha)
  (if (null linha)
      (format t "~%")
      (progn
        (format t "~a " 
                (if (car linha) (car linha) "-") 
        )
        (imprime-linha (cdr linha))
       )
  )
)

(defun imprime-tabuleiro (tabuleiro)
  (if (null tabuleiro)
      (format t "")
      (progn
        (imprime-linha (car tabuleiro))
        (imprime-tabuleiro (cdr tabuleiro))
     )
  )
)

(defun jogada-humano (tabuleiro jogador)
  (format t "Jogador ~a, insira a linha e coluna (0, 1 ou 2): " jogador)
  (let ((linha (parse-integer (read-line)))
        (coluna (parse-integer (read-line)))
       )
    (if (or 
            (< linha 0) (> linha 2) (< coluna 0) (> coluna 2) 
            (nth coluna (nth linha tabuleiro))
        )
        (progn
          (format t "Jogada inválida. Tente novamente.~%")
          (jogada-humano tabuleiro jogador)
        )
        (setf (nth coluna (nth linha tabuleiro)) jogador)
    )
  )
  tabuleiro
)

(defun linha-preenchida-p (linha)
  (if (null linha)
      t
      (and 
       (car linha)
       (linha-preenchida-p (cdr linha))
      )
  )
)

(defun tabuleiro-preenchidop (tabuleiro)
  (if (null tabuleiro)
      t
      (and 
       (linha-preenchida-p (car tabuleiro))
       (tabuleiro-preenchidop (cdr tabuleiro))
      )
  )
)

(defun verifica-linha (linha)
  (and 
   (not (null (car linha))) 
   (every (lambda (x) (eql x (car linha))) linha)
  )
)

(defun verifica-colunas (tabuleiro col)
  (if (= col 3)
      nil
      (or ( verifica-linha (mapcar (lambda (linha) (nth col linha)) tabuleiro) )
          ( verifica-colunas tabuleiro (1+ col) )
      )
  )
)

(defun verifica-diagonais (tabuleiro)
  (or ( verifica-linha (mapcar (lambda (i) (nth i (nth i tabuleiro))) '(0 1 2)) )
      ( verifica-linha (mapcar (lambda (i) (nth (- 2 i) (nth i tabuleiro))) '(0 1 2)) )
  )
)

(defun tabuleiro-solucao (tabuleiro)
  (or (some #'verifica-linha tabuleiro)
      (verifica-colunas tabuleiro 0)
      (verifica-diagonais tabuleiro)
  )
)

(defun minimax (tabuleiro profundidade maximizando-jogador)
  (let ( (vencedor (tabuleiro-solucao tabuleiro)) )
    (cond
      (vencedor (if (eql vencedor 'X) 1 -1))
      ((tabuleiro-preenchidop tabuleiro) 0)
      (t
       (if maximizando-jogador
           (maximiza tabuleiro profundidade)
           (minimiza tabuleiro profundidade)
       )
      )
    )
  )
)

(defun maximiza (tabuleiro profundidade)
  (let ((max-avaliacao -2))
    (maximiza-rec tabuleiro profundidade 0 0 max-avaliacao)
  )
)

(defun maximiza-rec (tabuleiro profundidade i j max-avaliacao)
  (if (= i 3)
      max-avaliacao
      (if (= j 3)
          (maximiza-rec tabuleiro profundidade (1+ i) 0 max-avaliacao)
          (if (nth j (nth i tabuleiro))
              (maximiza-rec tabuleiro profundidade i (1+ j) max-avaliacao)
              (progn
                (setf (nth j (nth i tabuleiro)) 'X)
                (let ( (avaliacao (minimax tabuleiro (1- profundidade) nil)) )
                  (setf max-avaliacao (max max-avaliacao avaliacao)))
                ( setf (nth j (nth i tabuleiro)) nil )
                (maximiza-rec tabuleiro profundidade i (1+ j) max-avaliacao)
              )
          )
     )
  )
)

(defun minimiza (tabuleiro profundidade)
  (let ((min-avaliacao 2))
    (minimiza-rec tabuleiro profundidade 0 0 min-avaliacao)
  )
)

(defun minimiza-rec (tabuleiro profundidade i j min-avaliacao)
  (if (= i 3)
      min-avaliacao
      (if (= j 3)
          (minimiza-rec tabuleiro profundidade (1+ i) 0 min-avaliacao)
          (if (nth j (nth i tabuleiro))
              (minimiza-rec tabuleiro profundidade i (1+ j) min-avaliacao)
              (progn
                (setf (nth j (nth i tabuleiro)) 'O)
                (let ((avaliacao (minimax tabuleiro (1- profundidade) t)))
                  (setf min-avaliacao (min min-avaliacao avaliacao)))
                (setf (nth j (nth i tabuleiro)) nil)
                (minimiza-rec tabuleiro profundidade i (1+ j) min-avaliacao)
              )
          )
      )
  )
)

(defun melhor-jogada (tabuleiro)
  (melhor-jogada-rec tabuleiro 0 0 -2 nil))

(defun melhor-jogada-rec (tabuleiro i j melhor-avaliacao melhor-movimento)
  (if (= i 3)
      melhor-movimento
      (if (= j 3)
          (melhor-jogada-rec tabuleiro (1+ i) 0 melhor-avaliacao melhor-movimento)
          (if (nth j (nth i tabuleiro))
              (melhor-jogada-rec tabuleiro i (1+ j) melhor-avaliacao melhor-movimento)
              (progn
                (setf (nth j (nth i tabuleiro)) 'X)
                (let ((avaliacao (minimax tabuleiro 0 nil)))
                  (if (> avaliacao melhor-avaliacao)
                      (setf melhor-avaliacao avaliacao
                            melhor-movimento (list i j))))
                (setf (nth j (nth i tabuleiro)) nil)
                (melhor-jogada-rec tabuleiro i (1+ j) melhor-avaliacao melhor-movimento)
              )
          )
      )
  )
)

(defun jogada-computador (tabuleiro)
  (let ((movimento (melhor-jogada tabuleiro)))
    ( setf (nth (second movimento) (nth (first movimento) tabuleiro)) 'X )
  )
  tabuleiro
)

(defun jogo-do-galo ()
  (let ((tabuleiro (cria-tabuleiro)))
    (jogo-do-galo-rec tabuleiro 'X)
  )
)

(defun jogo-do-galo-rec (tabuleiro jogador)
  (imprime-tabuleiro tabuleiro)
  (if (or (tabuleiro-preenchidop tabuleiro) (tabuleiro-solucao tabuleiro))
      (if (tabuleiro-solucao tabuleiro)
          (format t "Jogador ~a venceu!~%" (if (eql jogador 'X) 'O 'X))
          (format t "Empate!~%")
      )
      (progn
        (if (eql jogador 'X)
            (setf tabuleiro (jogada-computador tabuleiro))
            (setf tabuleiro (jogada-humano tabuleiro jogador))
        )
        (jogo-do-galo-rec tabuleiro (if (eql jogador 'X) 'O 'X))
      )
  )
)

(defun teste-minimax ()
  (let ((tabuleiro (cria-tabuleiro)))

    ;; Simula algumas jogadas
    (setf (nth 0 (nth 0 tabuleiro)) 'X)
    (setf (nth 1 (nth 1 tabuleiro)) 'O)
    (setf (nth 1 (nth 0 tabuleiro)) 'X)
    (imprime-tabuleiro tabuleiro)

    ;; Computador faz a próxima jogada
    (setf tabuleiro (jogada-computador tabuleiro))
    (imprime-tabuleiro tabuleiro)
  )
)