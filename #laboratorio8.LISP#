(defun ordenar-nos (lista-nos)
  "Ordena uma lista de nós pelo custo (profundidade + heurística)."
  (sort lista-nos #'(lambda (n1 n2)
                      ( < (no-custo n1) (no-custo n2)) )
  )
)

