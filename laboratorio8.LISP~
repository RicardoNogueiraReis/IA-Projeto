(defun retorna-no-objetivo (lista-sucessores funcaoObjetivo)
  (cond
   ( (null lista-sucessores)
     nil
   )
   ( (null (funcall funcaoObjetivo (car lista-sucessores)))
     (retorna-no-objetivo (cdr lista-sucessores) funcaoObjetivo)
   )
   ( t
     (car lista-sucessores)
   )
  )

)

(defun no-redundante-p (sucessor fechados)
  "Verifica se o sucessor já existe nos fechados e verifica se ."
  (cond
    ( (null fechados) nil)
    ( (and
        (equal (no-estado sucessor) (no-estado (car fechados)))
        (<= (no-custo (car fechados)) (no-custo sucessor))
      )
      t
    )
    (t (no-redundante-p sucessor (cdr fechados)))
  )
)

(defun a* (abertos fechados funcaoObjetivo funcao-sucessores operadores funcao-heuristica &optional (nos-gerados 0) (nos-expandidos 0))
  "Algoritmo A* implementado de forma recursiva, garantindo a gravação da heurística e do pai."
  (cond
    ((null abertos) nil)
    (t
     (let* ((n (car abertos))
            (nos-sucessores (remove nil (funcall funcao-sucessores n operadores funcao-heuristica)))
            (nos-filtrados
             (remove-if #'(lambda (sucessor) (no-redundante-p sucessor fechados)) nos-sucessores))
            (novos-abertos (colocar-sucessores-em-abertos (cdr abertos) nos-filtrados))
            (novos-fechados (cons n fechados))
            (nos-expandidos-novos (1+ nos-expandidos)) ;; Incrementa nós expandidos
            (nos-gerados-novos (+ nos-gerados (length nos-sucessores)))
            (no-objetivo (retorna-no-objetivo nos-sucessores funcaoObjetivo)))

       ;; Incrementa nós expandidos se a solução for encontrada imediatamente
       (when (funcall funcaoObjetivo n)
         (incf nos-expandidos-novos))

       (cond
         (no-objetivo
          no-objetivo)
         (t
          (a* novos-abertos
              novos-fechados
              funcaoObjetivo
              funcao-sucessores
              operadores
              funcao-heuristica
              nos-gerados-novos
              nos-expandidos-novos)
         )
       )
     )
    )
  )
)


(defun mostrar-solucao (no)
  "Exibe o caminho do estado inicial até o estado final."
  (cond
    ( (null no) nil)
    (t
     (mostrar-solucao (no-pai no))
     (escreve-no no)
    )
  )
)


