(defun fator-ramificacao (comprimento-caminho nos-gerados)
  "Calcula o fator de ramifica磯 m餩o resolvendo b^(n+1) - 1 = T * (b - 1)."
  (if (and (numberp comprimento-caminho)
           (numberp nos-gerados)
           (> comprimento-caminho 0)
           (> nos-gerados 0)
      )
      (bisseccao
       (lambda (b) (- (/ (- (expt b (1+ comprimento-caminho)) 1) (- b 1)) nos-gerados))
       1.01  ;; Limite inferior para evitar divis㯠por zero
       10    ;; Limite superior para garantir convergꮣia
       0.0001)
      "Indefinido"
  )
)

