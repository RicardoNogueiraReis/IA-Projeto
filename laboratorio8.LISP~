(defun retorna-no-objetivo (lista-sucessores funcaoObjetivo)
  (cond
   ( (null lista-sucessores)
     nil
   )
   ( (null (funcall funcaoObjetivo (car lista-sucessores)))
     (retorna-no-objetivo (cdr lista-sucessores) funcaoObjetivo)
   )
   ( t
     (car lista-sucessores)
   )
  )

)

(defun no-redundante-p (sucessor lista)
  "Verifica se o sucessor já existe na lista de abertos/fechados."
  (cond
    ( (null lista) nil)
    ( (and
        (equal (no-estado sucessor) (no-estado (car lista)))
        (<= (no-custo (car lista)) (no-custo sucessor))
      )
      t
    )
    (t (no-redundante-p sucessor (cdr lista)))
  )
)

(defun a* (abertos fechados funcaoObjetivo funcao-sucessores operadores funcao-heuristica &optional (nos-gerados 0) (nos-expandidos 0))
  "Algoritmo A* implementado de forma recursiva, garantindo a gravação da heurística e do pai."
  (cond
    ;; Caso base: lista de abertos vazia
    ((null abertos) nil)

    (t
     (let* ((n (car abertos))  ;; Pega o n󠡴ual para expandir
            ;; Incrementa o contador de n󳠥xpandidos
            (nos-expandidos-novos (1+ nos-expandidos)) ;; Atualiza ao expandir "n"

            ;; Gerar sucessores do n󠡴ual
            (nos-sucessores (remove nil (funcall funcao-sucessores n operadores funcao-heuristica)))

            ;; Filtra sucessores redundantes
            (nos-filtrados
             (remove-if #'(lambda (sucessor) (no-redundante-p sucessor fechados)) nos-sucessores))

            ;; Incrementa o contador de n󳠧erados
            (nos-gerados-novos (+ nos-gerados (length nos-filtrados))) ;; Incrementa com base nos sucessores vᬩdos

            ;; Adiciona sucessores a "abertos"
            (novos-abertos (colocar-sucessores-em-abertos (cdr abertos) nos-filtrados))
            (novos-fechados (cons n fechados)) ;; Atualiza lista de fechados

            ;; Verifica se algum dos sucessores 頵ma solu磯
            (no-objetivo (retorna-no-objetivo nos-sucessores funcaoObjetivo)) ;; Verifica se algum sucessor 頯bjetivo
           )

       ;; Verifica se o n󠡴ual 頳olu磯
       (if no-objetivo
           ;; Retorna o n󠯢jetivo com os contadores finais
           (list :solucao no-objetivo
                 :nos-gerados nos-gerados-novos
                 :nos-expandidos nos-expandidos-novos)
           ;; Caso contrᲩo, continua recursivamente
           (a* novos-abertos
               novos-fechados
               funcaoObjetivo
               funcao-sucessores
               operadores
               funcao-heuristica
               nos-gerados-novos
               nos-expandidos-novos)
       )
      )
    )
  )
)

