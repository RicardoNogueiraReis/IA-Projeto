(defun cria-tabuleiro ()
  (make-array '(3 3) :initial-element nil))

(defun imprime-tabuleiro (tabuleiro)
  (dotimes (i 3)
    (dotimes (j 3)
      (format t "~a " (if (aref tabuleiro i j) (aref tabuleiro i j) "-")))
    (format t "~%")))

(defun jogada-humano (tabuleiro jogador)
  (format t "Jogador ~a, insira a linha e coluna (0, 1 ou 2): " jogador)
  (let ((linha (parse-integer (read-line)))
        (coluna (parse-integer (read-line))))
    (if (or (< linha 0) (> linha 2) (< coluna 0) (> coluna 2) (aref tabuleiro linha coluna))
        (progn
          (format t "Jogada inválida. Tente novamente.~%")
          (jogada-humano tabuleiro jogador))
        (setf (aref tabuleiro linha coluna) jogador)))
  tabuleiro)

(defun tabuleiro-preenchidop (tabuleiro)
  (notany #'null (map 'list (lambda (i j) (aref tabuleiro i j)) '(0 0 0 1 1 1 2 2 2) '(0 1 2 0 1 2 0 1 2))))

(defun tabuleiro-solucao (tabuleiro)
  (let ((linhas (loop for i from 0 to 2 collect (map 'list (lambda (j) (aref tabuleiro i j)) '(0 1 2))))
        (colunas (loop for i from 0 to 2 collect (map 'list (lambda (j) (aref tabuleiro j i)) '(0 1 2))))
        (diagonais (list (map 'list (lambda (i) (aref tabuleiro i i)) '(0 1 2))
                         (map 'list (lambda (i) (aref tabuleiro i (- 2 i))) '(0 1 2)))))
    (or (some (lambda (linha) (and (not (null (first linha))) (every (lambda (x) (eql x (first linha))) linha))) linhas)
        (some (lambda (coluna) (and (not (null (first coluna))) (every (lambda (x) (eql x (first coluna))) coluna))) colunas)
        (some (lambda (diagonal) (and (not (null (first diagonal))) (every (lambda (x) (eql x (first diagonal))) diagonal))) diagonais))))

(defun minimax (tabuleiro profundidade maximizando-jogador)
  (let ((vencedor (tabuleiro-solucao tabuleiro)))
    (cond
      (vencedor (if (eql vencedor 'X) 1 -1))
      ((tabuleiro-preenchidop tabuleiro) 0)
      (t
       (if maximizando-jogador
           (let ((max-avaliacao -2))
             (dotimes (i 3)
               (dotimes (j 3)
                 (when (null (aref tabuleiro i j))
                   (setf (aref tabuleiro i j) 'X)
                   (let ((avaliacao (minimax tabuleiro (1- profundidade) nil)))
                     (setf max-avaliacao (max max-avaliacao avaliacao)))
                   (setf (aref tabuleiro i j) nil))))
             max-avaliacao)
           (let ((min-avaliacao 2))
             (dotimes (i 3)
               (dotimes (j 3)
                 (when (null (aref tabuleiro i j))
                   (setf (aref tabuleiro i j) 'O)
                   (let ((avaliacao (minimax tabuleiro (1- profundidade) t)))
                     (setf min-avaliacao (min min-avaliacao avaliacao)))
                   (setf (aref tabuleiro i j) nil))))
             min-avaliacao))))))

(defun melhor-jogada (tabuleiro)
  (let ((melhor-avaliacao -2)
        (melhor-movimento nil))
    (dotimes (i 3)
      (dotimes (j 3)
        (when (null (aref tabuleiro i j))
          (setf (aref tabuleiro i j) 'X)
          (let ((avaliacao (minimax tabuleiro 0 nil)))
            (when (> avaliacao melhor-avaliacao)
              (setf melhor-avaliacao avaliacao)
              (setf melhor-movimento (list i j))))
          (setf (aref tabuleiro i j) nil))))
    melhor-movimento))

(defun jogada-computador (tabuleiro)
  (let ((movimento (melhor-jogada tabuleiro)))
    (setf (aref tabuleiro (first movimento) (second movimento)) 'X))
  tabuleiro)

(defun jogo-do-galo ()
  (let ((tabuleiro (cria-tabuleiro))
        (jogador 'X))
    (loop until (or (tabuleiro-preenchidop tabuleiro) (tabuleiro-solucao tabuleiro))
          do (progn
               (imprime-tabuleiro tabuleiro)
               (if (eql jogador 'X)
                   (setf tabuleiro (jogada-computador tabuleiro))
                   (setf tabuleiro (jogada-humano tabuleiro jogador)))
               (setf jogador (if (eql jogador 'X) 'O 'X))))
    (imprime-tabuleiro tabuleiro)
    (if (tabuleiro-solucao tabuleiro)
        (format t "Jogador ~a venceu!~%" (if (eql jogador 'X) 'O 'X))
        (format t "Empate!~%"))))

(defun teste-minimax ()
  (let ((tabuleiro (cria-tabuleiro)))
    ;; Simula algumas jogadas
    (setf (aref tabuleiro 0 0) 'X)
    (setf (aref tabuleiro 1 1) 'O)
    (setf (aref tabuleiro 0 1) 'X)
    (imprime-tabuleiro tabuleiro)
    ;; Computador faz a próxima jogada
    (setf tabuleiro (jogada-computador tabuleiro))
    (imprime-tabuleiro tabuleiro)))